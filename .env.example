# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API

# Your project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon / public" API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" secret key. NEVER expose this in the browser.
# The server uses it to act for applicants (who sign in with name + PIN).
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL: OpenAI API key (platform.openai.com -> API keys). When set,
# each uploaded document is automatically categorized ("Pay stub",
# "Bank statement", ...) so the landlord sees a summary per applicant.
# Uploads still work without it - documents just stay uncategorized.
OPENAI_API_KEY=

# OPTIONAL: which OpenAI model to use for categorizing (default: gpt-5-mini).
# OPENAI_MODEL=gpt-5-mini

# OPTIONAL: access code for the landlord view. When set, opening the
# dashboard asks for this code once (no account needed). When unset,
# ANYONE with the app URL can open the landlord view - fine for testing,
# not recommended once real documents are in there.
# DIGITS ONLY (e.g. 245981) - the code field opens the numeric keyboard
# on phones, so letters cannot be typed.
# LANDLORD_CODE=

# OPTIONAL: secret used to sign session cookies. If not set, the service
# role key is used for signing instead. Set it to any long random
# string, e.g. the output of: openssl rand -hex 32
# SESSION_SECRET=
