# ============================================================
# RentFolio — chaves de ambiente para a Vercel
# ============================================================
#
# COMO USAR:
# 1. Copie este arquivo:  cp vercel.env.example .env.vercel.local
#    (.env.vercel.local esta no .gitignore, entao suas chaves
#    reais NUNCA vao pro GitHub — nao preencha este arquivo aqui!)
# 2. Preencha os valores no .env.vercel.local seguindo os
#    comentarios abaixo.
# 3. Na Vercel: seu projeto -> Settings -> Environment Variables.
#    Copie o conteudo inteiro do .env.vercel.local e COLE no campo
#    "Key" — a Vercel expande todas as linhas de uma vez.
# 4. Marque os ambientes (Production, Preview, Development) e Save.
# 5. Faça um novo deploy (Deployments -> ... -> Redeploy) para as
#    variaveis valerem.
#
# Dica: as mesmas linhas servem para rodar local — e so copiar
# tambem para o .env.local.

# ------------------------------------------------------------
# SUPABASE  (supabase.com -> seu projeto -> Project Settings -> API)
# ------------------------------------------------------------

# "Project URL", ex.: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave "anon / public" (pode aparecer no navegador, sem problema)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" — SECRETA. So vive no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# OPENAI  (platform.openai.com -> API keys)
# Opcional: sem ela o app funciona, mas os documentos ficam sem
# categoria automatica ("Pay stub", "Bank statement", ...).
# ------------------------------------------------------------

OPENAI_API_KEY=

# Opcional: modelo usado na classificacao. Padrao: gpt-5-mini.
# So preencha se quiser outro modelo.
OPENAI_MODEL=

# ------------------------------------------------------------
# SESSAO DOS INQUILINOS
# Opcional mas recomendado: assina o cookie de login dos
# candidatos (nome + PIN). Gere um valor com:
#   openssl rand -hex 32
# Se ficar vazio, a service_role key e usada como fallback.
# ------------------------------------------------------------

SESSION_SECRET=
